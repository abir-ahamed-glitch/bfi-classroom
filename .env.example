# BFI Classroom - Environment Configuration Template
# Duplicate this file to .env and configure real credentials securely.
# NEVER commit .env to source control!

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
APP_URL=http://localhost:5174

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_hex_string
MESSAGE_ENCRYPTION_KEY=replace_with_a_secure_random_32_character_hex_key
# Dedicated MFA Encryption Key (Primary AES-256-GCM key for column-level TOTP secrets; falls back to JWT_SECRET if unset)
MFA_ENCRYPTION_KEY=

# Retired Key Fallback for Decryptability (Written during secret rotation)
# NOTE: These are NOT second active secrets. They are retained solely to decrypt existing
# ciphertext (e.g. stored TOTP MFA secrets in SQLite) that was encrypted prior to key rotation.
# During rotation, scripts/production_lifecycle.cjs writes the prior active keys to these variables
# so fallback decryption succeeds until records are fully re-encrypted (server/utils/totp.js:78).
PREVIOUS_JWT_SECRET=
PREVIOUS_MFA_ENCRYPTION_KEY=

# Token Lifetimes
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_TIMEOUT=86400000
BCRYPT_ROUNDS=12

# Email Transport (SMTP)
EMAIL_USER=
EMAIL_PASS=

# SMS Gateway (Optional)
SMS_API_KEY=
SMS_SENDER_ID=

# Cloudflare Turnstile CAPTCHA (Optional)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
